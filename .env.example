# Copy this file to `.env` and fill in the values from your Supabase project:
# Supabase dashboard -> Project Settings -> API
#
# The EXPO_PUBLIC_ prefix makes the values available inside the app. The anon
# key is safe to ship in an app — Row Level Security in the database is what
# protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
